{
  "manifest_version": 3,
  "name": "DDL 课程同步",
  "version": "1.2.0",
  "description": "将 Gradescope、WebAssign、Keenly Tasks 和 ALEKS 截止日期同步到本机 Mac App。",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://*.aleks.com/*",
    "https://gradescope.com/*",
    "https://www.gradescope.com/*",
    "https://webassign.net/*",
    "https://www.webassign.net/*",
    "https://keenly.study/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DDL 课程同步"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.aleks.com/*",
        "https://gradescope.com/courses/*",
        "https://www.gradescope.com/courses/*",
        "https://webassign.net/v4cgi/student.pl*",
        "https://www.webassign.net/v4cgi/student.pl*",
        "https://keenly.study/*"
      ],
      "js": [
        "parser.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
